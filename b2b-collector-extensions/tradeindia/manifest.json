{
  "manifest_version": 3,
  "name": "CAPA B2B Supplier Collector",
  "version": "3.0.0",
  "description": "Collect and export supplier listings from IndiaMART Export, Made-in-China, and TradeIndia.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://export.indiamart.com/*",
    "https://*.made-in-china.com/*"
  ],
  "optional_host_permissions": [
    "https://www.tradeindia.com/*",
    "https://tradeindia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CAPA B2B Supplier Collector",
    "default_popup": "popup.html"
  }
}
